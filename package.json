{
  "name": "security-architecture-assessment",
  "displayName": "Security Architecture Assessment",
  "description": "Explainable, STRIDE-based security architecture assessment for VS Code workspaces.",
  "repository": {
  "type": "git",
  "url": "https://github.com/sujithmanchikanti3-del/Mini-Project-CSD-C17.git"
},
  "version": "0.5.0",
  "publisher": "sujithmanchikanti3-del",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:securityArchitectureAssessment.analyzeProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "securityArchitectureAssessment.analyzeProject",
        "title": "Security Architecture: Analyze Project"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/v02-regression.test.js test/v03-technology.test.js test/v04-architecture.test.js test/v04-audit.test.js test/v05-stride.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
